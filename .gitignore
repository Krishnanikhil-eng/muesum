# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Datasets (large image archives)
data/
*.jpg
*.jpeg
*.png
!assets/**/*.png
!assets/*.png
!release/**/*.png

# Exclude generated comparison PNGs from git
reports/**/visual_comparisons/
reports/**/plots/
reports/damage_preprocessing_samples/
reports/phase_f4_visual_comparisons/*.png

# Model checkpoints and weights
checkpoints/
outputs/
*.pth
*.pt
*.ckpt
*.bin
*.safetensors

# Temporary, backup, and log files
backup/
*.tmp
*.temp
*.bak
*.swp
*.log
!reports/*.log
!reports/*.md

# Environments
env/
venv/
ENV/
.env

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
